{
  "experiment_name": "demo_cifar100_4superclasses",
  "network_type": "resnet18",
  "initialization_method": "kaiming_normal",
  "dataset_id": "cifar100",
  "superclasses": ["aquatic_mammals", "flowers", "household_furniture", "vehicles_1"],
  "random_seed": 42,
  "batch_size": 128,
  "mps_max_batch": 128,
  "training_policy": {"epochs": 6, "accuracy_threshold": 35.0},
  "snapshot_policy": {"milestone_count": 4, "distribution_scheme": "uniform", "samples_per_class": 100},
  "transform_config": {"normalize_mean": [0.5071, 0.4867, 0.4408], "normalize_std": [0.2675, 0.2565, 0.2761],
                       "augmentation_enabled": true, "random_crop_padding": 4, "horizontal_flip": true},
  "optimizer": {"type": "sgd", "learning_rate": 0.1, "weight_decay": 0.0005, "momentum": 0.9, "nesterov": true},
  "sae_policy": {"expansion_factor": 4, "k_sparse": 32, "n_steps": 1000, "shared_init_seed": 42, "null_permutations": 20},
  "curriculum_policy": null,
  "noise_policy": null
}
